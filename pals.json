    },
    "vera": {
      "enabled": true,
      "description": "Privacy & data protection review"
    }
  },
  "git": {
    "workflow": "github-flow",
    "remote": "https://github.com/coctostan/pi-verify.git",
    "base_branch": "main",
    "merge_method": "squash",
    "worktree_isolation": false,
    "auto_push": true,
    "auto_pr": true,
    "ci_checks": true,
    "delete_branch_on_merge": true,
    "update_branch_when_behind": true,
    "require_pr_before_next_phase": true,
    "require_reviews": false
