    },
    "iris": {
      "enabled": true,
      "description": "Intelligent review & inspection system"
    },
    "skip": {
      "enabled": true,
      "description": "Smart knowledge & information persistence"
    },
    "dave": {
      "enabled": true,
      "description": "Deploy automation & verification engine"
    },
    "ruby": {
      "enabled": true,
      "description": "Refactor utility & better-code yielder"
    },
    "arch": {
      "enabled": true,
      "description": "Architecture boundary enforcement"
    },
    "aria": {
      "enabled": true,
      "description": "Accessibility review & audit"
    },
    "dana": {
      "enabled": true,
      "description": "Data access & migration safety"
    },
    "gabe": {
      "enabled": true,
      "description": "API contract & breaking-change guard"
    },
    "luke": {
      "enabled": true,
